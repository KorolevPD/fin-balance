# Скопируйте в .env и при необходимости замените значения перед `docker compose up`.
# В этот файл не помещайте реальные секреты.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=finbalance

# Backend
SECRET_KEY=your-secret-key-change-in-production

# Ключ шифрования AI-ключей пользователей (AES-GCM). Смените в продакшене.
AI_KEY_ENCRYPTION_KEY=

# Серверный GigaChat-ключ (Authorization Key из личного кабинета Сбера).
# Если заполнен — используется для всех пользователей, а раздел «AI-ассистент»
# в профиле скрывается. Если пуст — пользователь вводит свой ключ в профиле.
GIGACHAT_API_KEY=

# Корневой сертификат НУЦ Минцифры для TLS-доступа к GigaChat (*.sberbank.ru,
# *.giga.chat). Путь к PEM-файлу внутри контейнера/процесса; пустой = стандартный
# trust-store. Не отключает проверку TLS, только добавляет корень в цепочку доверия.
GIGACHAT_CA_BUNDLE=

# Telegram-бот. Без значения бот запускается в «спящем» режиме (отключён).
BOT_TOKEN=
API_URL=http://backend:8000
