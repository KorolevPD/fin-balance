# Скопируйте в .env и при необходимости замените значения перед `docker compose up`.
# В этот файл не помещайте реальные секреты.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=finbalance

# Backend
SECRET_KEY=your-secret-key-change-in-production

# Ключ шифрования AI-ключей пользователей (AES-GCM). Смените в продакшене.
AI_KEY_ENCRYPTION_KEY=

# Серверный Gemini-ключ. Если заполнен — используется для всех пользователей,
# и пользователь не может ввести свой ключ. Если пуст — пользователь вводит свой.
GEMINI_API_KEY=

# Telegram-бот. Без значения бот запускается в «спящем» режиме (отключён).
BOT_TOKEN=
API_URL=http://backend:8000
