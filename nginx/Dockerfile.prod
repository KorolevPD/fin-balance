# Прод-сборка nginx: образ из уже собранного фронтенда.
# SPA собирается на GitHub Actions runner (fast) в deploy.yml, на сервер
# передаются готовые статики frontend/build. Сервер не выполняет
# npm ci / npm run build (слабая машина: 1 vCPU, 1 ГБ RAM).
FROM nginx:1.25-alpine

COPY nginx/nginx.conf /etc/nginx/nginx.conf
COPY frontend/build /usr/share/nginx/html