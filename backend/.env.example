# Database URL
DATABASE_URL=postgresql://postgres:postgres@db:5432/finbalance

# JWT
SECRET_KEY=your-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Ключ шифрования AI-ключей пользователей (AES-GCM). Смените в продакшене.
AI_KEY_ENCRYPTION_KEY=

# Серверный Gemini-ключ. Если заполнен — используется для всех пользователей,
# и пользователь не может ввести свой ключ. Если пуст — пользователь вводит свой.
GEMINI_API_KEY=