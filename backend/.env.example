# Database URL
DATABASE_URL=postgresql://postgres:postgres@db:5432/finbalance

# JWT
SECRET_KEY=your-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Ключ шифрования AI-ключей пользователей (AES-GCM). Смените в продакшене.
AI_KEY_ENCRYPTION_KEY=

# Серверный GigaChat-ключ (Authorization Key из личного кабинета Сбера).
# Если заполнен — используется для всех пользователей, а раздел «AI-ассистент»
# в профиле скрывается. Если пуст — пользователь вводит свой ключ в профиле.
GIGACHAT_API_KEY=

# Корневой сертификат НУЦ Минцифры для TLS-доступа к GigaChat (*.sberbank.ru,
# *.giga.chat). Путь к PEM-файлу; пустой = стандартный trust-store.
GIGACHAT_CA_BUNDLE=